key = input("Enter key: ").upper()
text = input("Enter plaintext: ").upper()
table = ""
for ch in key + "ABCDEFGHIJKLMNOPQRSTUVWXYZ":
    if ch == "J":
        ch = "I"
    if ch not in table:
        table += ch
matrix = [table[i:i+5] for i in range(0, 25, 5)]
print("\nPlayfair Matrix:")
for row in matrix:
    print(row)
text = text.replace("J", "I")
if len(text) % 2 != 0:
    text += "X"
encrypted = ""
for i in range(0, len(text), 2):
    a = text[i]
    b = text[i+1]
    for r in range(5):
        for c in range(5):
            if matrix[r][c] == a:
                r1, c1 = r, c
            if matrix[r][c] == b:
                r2, c2 = r, c
    if r1 == r2:
        encrypted += matrix[r1][(c1 + 1) % 5]
        encrypted += matrix[r2][(c2 + 1) % 5]
    elif c1 == c2:
        encrypted += matrix[(r1 + 1) % 5][c1]
        encrypted += matrix[(r2 + 1) % 5][c2]
    else:
        encrypted += matrix[r1][c2]
        encrypted += matrix[r2][c1]
print("\nPlain Text :", text)
print("Encrypted Text :", encrypted)